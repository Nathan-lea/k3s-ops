# {{ ansible_managed }}
# =============================================================================
# 内网 CA 签发链（全离线可用，不依赖任何外部 ACME）
# =============================================================================
#   ClusterIssuer selfsigned
#        └─(签发)→ Certificate k3s-ops-ca（isCA，私钥留在集群内）
#                      └─(作为 CA)→ ClusterIssuer k3s-ops-ca  ← 业务直接用这个
#
# 业务用法（Ingress 上加注解）：
#   cert-manager.io/cluster-issuer: k3s-ops-ca
#
# 客户端要信任这套证书，需要导出 CA：
#   kubectl -n cert-manager get secret k3s-ops-ca -o jsonpath='{.data.ca\.crt}' | base64 -d
# =============================================================================
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: selfsigned
spec:
  selfSigned: {}
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: k3s-ops-ca
  namespace: cert-manager
spec:
  isCA: true
  commonName: {{ prod.cluster_name }}-internal-ca
  secretName: k3s-ops-ca
  duration: 87600h    # 10 年
  renewBefore: 720h   # 到期前 30 天自动续
  privateKey:
    algorithm: ECDSA
    size: 384
  issuerRef:
    name: selfsigned
    kind: ClusterIssuer
    group: cert-manager.io
---
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: k3s-ops-ca
spec:
  ca:
    secretName: k3s-ops-ca
{% if prod.certmanager.acme_email %}
---
# 仅当 config/cluster.env 里填了 ACME_EMAIL 才创建。
# ⚠️ 需要集群域名能被 Let's Encrypt 从公网解析并访问到 80 端口（http01），
#    纯内网环境请忽略这个 issuer。
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-prod
spec:
  acme:
    server: https://acme-v02.api.letsencrypt.org/directory
    email: {{ prod.certmanager.acme_email }}
    privateKeySecretRef:
      name: letsencrypt-prod
    solvers:
      - http01:
          ingress:
            class: nginx
{% endif %}
