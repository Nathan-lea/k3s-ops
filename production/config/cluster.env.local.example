# =============================================================================
# 本机覆盖 —— 复制成 cluster.env.local 后使用（该文件名已被 .gitignore 排除）
# =============================================================================
# 用途：放真实密码、镜像仓库凭据、只属于你这套环境的覆盖值。
# 它在 cluster.env 之后被 source，因此这里写的会赢。
#
#   cp production/config/cluster.env.local.example production/config/cluster.env.local
#   chmod 600 production/config/cluster.env.local
#
# ⚠️ 不要把填好的 cluster.env.local 提交进 git。
# =============================================================================

# ---- 初始化阶段的 root 密码（仅首次初始化用；之后 root 登录会被关掉）----
INIT_SSH_PASSWORD=ChangeMe-Init-Root

# ---- Rancher 初始密码（生产务必改）----
RANCHER_BOOTSTRAP_PASSWORD=ChangeMe-Rancher-Admin

# ---- 内网镜像仓库凭据（Artifactory）----
# REGISTRY_ENDPOINT=artifactory.example.com
# REGISTRY_PATH_PREFIX=docker-remote
# REGISTRY_USERNAME=your-user
# REGISTRY_PASSWORD=your-token

# ---- 环境相关覆盖示例 ----
# SSH_PORT=2222
# NFS_SERVER=192.168.100.50
# LOCALDISK_PATH=/data/k8s-local-path
# CLUSTER_DOMAIN=corp.internal
