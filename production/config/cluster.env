# =============================================================================
# production/ 主配置 —— 所有可变项都收敛到这里
# =============================================================================
# 读取顺序（后者覆盖前者）：本文件 → config/cluster.env.local → 环境变量
# 本文件可以提交进 git（只放占位值）；真实密码/凭据放 config/cluster.env.local。
#
# 语法：这是被 bash `source` 的普通 kv 文件，不要写 `export`，不要用 YAML 冒号。
# =============================================================================

# =============================================================================
# 1. 集群标识
# =============================================================================
CLUSTER_NAME=xxx-k8s
# Ingress 主机名后缀。留空则用 config/ipam.yml 的 domain。
CLUSTER_DOMAIN=k8s.example.com

# =============================================================================
# 2. k3s
# =============================================================================
# latest = 走 K3S_CHANNEL_URL 解析当前稳定版（preflight 阶段解析成具体版本号）；
# 也可以直接钉版本，例如 v1.36.5+k3s1。
K3S_VERSION=latest
K3S_CHANNEL_URL=https://update.k3s.io/v1-release/channels/stable

# online  = 从 K3S_DOWNLOAD_URL 下载 k3s 二进制（为空则用官方 GitHub releases）
# offline = 用 artifacts/k3s（配合 scripts/offline-load.sh 分发）
K3S_INSTALL_MODE=online
K3S_DOWNLOAD_URL=
# 内网/镜像示例（按需取消注释）：
# K3S_DOWNLOAD_URL=https://rancher-mirror.rancher.cn/k3s/k3s-<version>

# CNI：flannel（默认）| none（关闭内置 CNI，供后续自装 Calico/Cilium；本期不附带）
CNI=flannel
POD_CIDR=10.42.0.0/16
SVC_CIDR=10.43.0.0/16

# 与教程第 44 章结论一致：Traefik 与 ServiceLB 都关掉，对外统一走 nginx-ingress。
DISABLE_TRAEFIK=true
DISABLE_SERVICELB=true
# 小集群让 server 也能跑业务负载。
TAINT_SERVER=false

# =============================================================================
# 3. SSH / 运维账号
# =============================================================================
SSH_PORT=22
# 初始化阶段用 root + 密码；留空则读环境变量 INIT_SSH_PASSWORD，再不行就交互输入。
INIT_SSH_USER=root
INIT_SSH_PASSWORD=
OPS_USER=ops
# 运维私钥路径。留空则自动生成到 production/.state/ops_id_ed25519
OPS_SSH_KEY=
OPS_SUDO_NOPASSWD=true
# 仅在"ops + 密钥已验证可连"之后才会动 sshd_config。
DISABLE_ROOT_SSH_AFTER_INIT=true
# prohibit-password（推荐，先禁密码）| no（彻底禁 root 登录）
ROOT_SSH_POLICY=prohibit-password

# =============================================================================
# 4. OS 初始化
# =============================================================================
TIMEZONE=Asia/Shanghai
# 逗号分隔，每段原样成为一条 chrony `server` 行
CHRONY_SERVERS="ntp.aliyun.com iburst"
# apt 安装基础包前是否 apt update（内网源不可用时改成 false）
APT_UPDATE_CACHE=true
# false = 完全不碰 ufw（既不装包也不加规则）
USE_UFW=true
# ufw 放行网段（集群内互访）。80/443 一定会放行，因为 ingress 直接占宿主机端口。
UFW_ALLOW_CIDR=192.168.100.0/24
ENABLE_LIMITS=true

# =============================================================================
# 5. 存储
# =============================================================================
# ---- 本地盘（localdisk StorageClass）----
LOCALDISK_ENABLED=true
LOCALDISK_PATH=/opt/k8s-local-path
LOCALDISK_SC_NAME=localdisk
LOCALDISK_DEFAULT_SC=true
LOCALDISK_RECLAIM_POLICY=Retain
LOCALDISK_IMAGE=rancher/local-path-provisioner:v0.0.30
# provisioner 用来 mkdir/rm 卷目录的辅助 pod 镜像（离线准备镜像时要一起导入）
LOCALDISK_HELPER_IMAGE=rancher/mirrored-library-busybox:1.36.1

# ---- NFS（nfs-client StorageClass）----
# 默认关闭：占位的 NFS_SERVER 不填就启用会被 preflight 拦下（一键部署开箱即跑）。
# 要用 NFS：把 NFS_SERVER 改成真实地址，再把本项改回 true。
STORAGE_NFS_ENABLED=false
# 集群内部署 NFS Server：默认关闭。开启前必须先把镜像弄进内网仓库
# （见 addons/in-cluster-nfs/manifests.yaml.j2 顶部说明）。
IN_CLUSTER_NFS=false
# 外部 NFS Server。⚠️ STORAGE_NFS_ENABLED=true 时占位值必须改掉：preflight 会拦住 placeholder。
NFS_SERVER=nfs-server.example.com
NFS_PATH=/nfs-share
NFS_VERSION=4
NFS_SC_NAME=nfs-client
NFS_RECLAIM_POLICY=Delete
# reclaimPolicy=Delete 时：true = PVC 删除后把目录改名归档（archived-*）而不真删
NFS_ARCHIVE_ON_DELETE=false
NFS_PROVISIONER_IMAGE=registry.k8s.io/sig-storage/nfs-subdir-external-provisioner:v4.0.2
# 与 LOCALDISK_DEFAULT_SC 互斥（都为 true 时 preflight 报错）
NFS_DEFAULT_SC=false

# =============================================================================
# 6. Ingress（hostNetwork + DaemonSet，直接占宿主机 80/443，不保留 NodePort）
# =============================================================================
INGRESS_ENABLED=true
INGRESS_CHART_VERSION=4.11.0
# DaemonSet = 每个节点各一个副本，任意节点 IP 都能访问
INGRESS_KIND=DaemonSet
INGRESS_HTTP_PORT=80
INGRESS_HTTPS_PORT=443
# 留空 = 所有节点都跑；填 label 选择器可只让部分节点承载入口
# 例：INGRESS_NODE_SELECTOR=node-role.example.com/ingress=true
INGRESS_NODE_SELECTOR=

# =============================================================================
# 7. 附加组件
# =============================================================================
CERT_MANAGER_ENABLED=true
CERT_MANAGER_CHART_VERSION=v1.20.2
# 留空 = 只建内网 CA（ClusterIssuer internal-ca），不建 Let's Encrypt
ACME_EMAIL=

RANCHER_ENABLED=true
RANCHER_CHART_VERSION=2.15.2
RANCHER_HOSTNAME=rancher.${CLUSTER_DOMAIN}
RANCHER_REPLICAS=1
# 演示值。生产请放进 config/cluster.env.local
RANCHER_BOOTSTRAP_PASSWORD=admin
# rancher（默认：Rancher 用 cert-manager 自签一套 CA）| letsEncrypt | secret
# 注意：Rancher 依赖集群里已装好的 cert-manager，所以 CERT_MANAGER_ENABLED 必须为 true
RANCHER_TLS_SOURCE=rancher

# =============================================================================
# 8. 制品与镜像仓库
# =============================================================================
# local = 用 charts/*.tgz 本地 chart；repo = 用 Helm 仓库
CHARTS_MODE=local
# 离线镜像 tar 所在目录（相对 production/）
ARTIFACTS_DIR=artifacts

# registry.k8s.io 等镜像仓库前缀（留空 = 不改，沿用父仓库的 containerd 加速配置）
# 例：REGISTRY_MIRRORS="docker.io=https://<artifactory>/docker-remote"
REGISTRY_MIRRORS=

# 内网镜像仓库（Artifactory）。填了以后会写进各节点的 registries.yaml。
# 凭据建议只写在 config/cluster.env.local。
REGISTRY_ENDPOINT=
REGISTRY_PATH_PREFIX=
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# Helm 来源（addons 阶段在首个 server 上执行）
HELM_VERSION=v3.16.3
HELM_DOWNLOAD_URL=
HELM_BIN=
