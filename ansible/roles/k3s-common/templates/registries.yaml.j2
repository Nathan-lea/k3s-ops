{% if containerd_mirrors is defined %}
mirrors:
{% for registry, mirrors in containerd_mirrors.items() %}
  {{ registry }}:
    endpoint:
{% for mirror in mirrors %}
      - "{{ mirror }}"
{% endfor %}
{% endfor %}
configs:
{% set _creds = containerd_registry_credentials | default({}) %}
{% if _creds | length > 0 %}
{% for host, cred in _creds.items() %}
  "{{ host }}":
    auth:
      username: "{{ cred.username }}"
      password: "{{ cred.password }}"
{% endfor %}
{% else %}
  "docker.io":
    auth: {}
{% endif %}
{% endif %}
